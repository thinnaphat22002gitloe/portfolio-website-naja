# Copy to tmrw-backend/.env and adjust. Never commit the real .env.
DATABASE_URL=sqlite:///./tmrw.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/tmrw

APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
CONTACT_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# JWT signing secret. Leave empty in local dev -> a random secret is generated per run
# (you just log in again after a restart). REQUIRED in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# First admin account (created once, on first start, if it does not exist yet).
# DEV DEFAULT ONLY: admin@tmrw.unlimited / changeme123  - the server refuses this
# password when APP_ENV=production. Change it after your first login in production.
ADMIN_EMAIL=admin@tmrw.unlimited
ADMIN_PASSWORD=changeme123
ADMIN_NAME=TMRW Admin

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
PORT=8000
